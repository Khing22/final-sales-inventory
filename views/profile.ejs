<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> —justin-stock</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app">
    <%- include("partials/sidebar") %>
    <main class="main">
      <%- include("partials/header") %>
      <section class="content">
<div class="page-heading"><div><h1>Profile</h1><p>Manage your Stock account information.</p></div></div>
<section class="card profile-card"><div class="profile-avatar">A</div><h2><%= admin.name %></h2><p><%= admin.email %></p><span class="role"><%= admin.role %></span><hr><div class="profile-fields"><label>Full name<input value="<%= admin.name %>"></label><label>Email<input value="<%= admin.email %>"></label></div><button class="btn-primary">Save Changes</button></section>
      </section>
    </main>
  </div>
  <%- include("partials/footer") %>
</body>
</html>
